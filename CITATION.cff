repository: "https://github.com/embarkco/closing-costs-by-state"
date-released: "2026-10-01"
version: "2026-10-01"
keywords:
  - "closing costs by state"
  - "seller closing costs"
  - "buyer closing costs"
  - "transfer tax"
  - "title insurance"
